NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_API_TIMEOUT_MS=12000

# Vercel production example:
# NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app
# NEXT_PUBLIC_API_BASE_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_WS_BASE_URL=wss://your-api.up.railway.app
# NEXT_PUBLIC_DEPLOY_ENV=production

# Chi bat true khi can demo UI khong goi backend.
# Staging/production bat buoc false.
NEXT_PUBLIC_USE_MOCKS=false

