# ==============================================================================
# YAG ROOT DOCKER COMPOSE ENVIRONMENT TEMPLATE
# Copy this file to .env at the repository root when using Docker Compose.
# Never commit the real .env file.
# ==============================================================================

# Application
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
QUEUE_PROVIDER=rabbitmq
INTERNAL_TASK_TOKEN=
INTERNAL_SERVICE_ACCOUNT_EMAIL=
INTERNAL_AUTH_AUDIENCE=

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_SERVER=postgres
POSTGRES_USER=yag_user
POSTGRES_PASSWORD=yag_secret
POSTGRES_DB=yag_db

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_DASHBOARD_PORT=15672
RABBITMQ_USER=yag_mq
RABBITMQ_PASSWORD=yag_mq_secret

# Google Pub/Sub queue option for Cloud Run production
GCP_PROJECT_ID=
PUBSUB_PROJECT_ID=
PUBSUB_MODERATION_TOPIC=yag-moderation

# AI
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayOS Integration Settings
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/result
PAYOS_MOCK_ENABLED=false

# SMTP (required in production)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Frontend build args used by Docker Compose
FRONTEND_PUBLIC_URL=http://localhost
API_PUBLIC_URL=http://localhost
WS_PUBLIC_URL=ws://localhost/ws
API_TIMEOUT_MS=12000

# Nginx exposed ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
