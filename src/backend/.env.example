# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - YAG BACKEND SERVICE
# Copy this file to .env and fill in the secrets for local development.
# ==============================================================================

# Application Settings
PROJECT_NAME="YAG - Smart Novel Writing Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SERVICE_ROLE="api"
QUEUE_PROVIDER="rabbitmq"
SECRET_KEY="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOW_WEBSOCKET_QUERY_TOKEN=true
INTERNAL_TASK_TOKEN=""
INTERNAL_SERVICE_ACCOUNT_EMAIL=""
INTERNAL_AUTH_AUDIENCE=""

# Database Configuration (PostgreSQL with pgvector extension)
POSTGRES_SERVER="localhost"
POSTGRES_USER="yag_user"
POSTGRES_PASSWORD="yag_secret"
POSTGRES_DB="yag_db"
# DATABASE_URL="postgresql://yag_user:yag_secret@localhost:5432/yag_db"
# Supabase production example:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
# Optional: required only with import_demo_library --enable-author-login.
DEMO_AUTHOR_PASSWORD=""

# Redis Cache & Session Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_URL="redis://localhost:6379/0"
# Upstash production example:
# REDIS_URL="rediss://default:UPSTASH_TOKEN@REGION.upstash.io:6379"

# RabbitMQ Message Broker Configuration
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="yag_mq"
RABBITMQ_PASSWORD="yag_mq_secret"
RABBITMQ_MODERATION_QUEUE="ai.moderation"
RABBITMQ_MODERATION_RETRY_QUEUE="ai.moderation.retry"
RABBITMQ_MODERATION_DLQ="ai.moderation.dlq"
RABBITMQ_MODERATION_MAX_RETRIES=5
# RABBITMQ_URL="amqp://yag_mq:CHANGE_ME@localhost:5672/"
# CloudAMQP production example:
# RABBITMQ_URL="amqps://USER:PASSWORD@HOST/VHOST"

# Google Pub/Sub queue option for Cloud Run production deployments.
# Use QUEUE_PROVIDER="pubsub" and configure an authenticated push subscription
# to /api/v1/internal/pubsub/moderation.
GCP_PROJECT_ID=""
PUBSUB_PROJECT_ID=""
PUBSUB_MODERATION_TOPIC="yag-async-tasks"

# Google Gemini API Settings (U006 plot suggestions, U008 semantic embeddings, U013 moderation)
# NOTE: gemini-1.5-* and text-embedding-004 were shut down in early 2026.
# Use gemini-2.5-flash/pro and gemini-embedding-001 instead.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_STRONG_MODEL="gemini-2.5-pro"
GEMINI_FAST_MODEL="gemini-2.5-flash"
GEMINI_MODERATION_MODEL="gemini-2.5-pro"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=30.0
AI_CONTEXT_WORD_LIMIT=1000
AI_AGENT_ENABLED=true
AI_TOOL_TRACE_ENABLED=false
AI_MODERATION_STRICT_MODE=true
AI_MAX_CONTEXT_CHARS=12000
AI_AUTHOR_STYLE_CHAPTER_LIMIT=12
AI_RECOMMENDATION_CANDIDATE_LIMIT=20
AI_MODERATION_APPROVE_THRESHOLD=0.72
AI_MODERATION_REJECT_THRESHOLD=0.82

# Cloudinary CDN Configuration (U002 user avatar, U003 story cover)
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME_HERE"
CLOUDINARY_API_KEY="YOUR_API_KEY_HERE"
CLOUDINARY_API_SECRET="YOUR_API_SECRET_HERE"

# PayOS Billing Configuration (U012 premium billing)
PAYMENT_PROVIDER="payos"
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID_HERE"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY_HERE"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY_HERE"
PAYOS_RETURN_URL="http://localhost:3000/payment/result"
PAYOS_MOCK_ENABLED=false

# SMTP Configuration (required in production)
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Background jobs should normally run as separate services in production.
SCHEDULER_ENABLED=false
VIEW_COUNT_FLUSH_ENABLED=false
AUTO_CREATE_TABLES=false
APPLY_MIGRATIONS_ON_STARTUP=false
